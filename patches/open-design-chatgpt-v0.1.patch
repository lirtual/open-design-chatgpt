@@ -0,0 +1,252 @@
+import { createHash } from 'node:crypto';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import {
+  handleMcpToolCall,
+  localMcpToolDefinitions,
+} from '../src/mcp.js';
+import { _resetMcpWorkspaceContextCacheForTests } from '../src/mcp-workspace-context.js';
+
+const originalFetch = globalThis.fetch;
+const originalExportMaxBytes = process.env.OD_MCP_EXPORT_MAX_BYTES;
+const PROJECT_ID = '11111111-1111-4111-8111-111111111111';
+
+function firstText(result: { content: Array<{ text: string }> }): string {
+  const item = result.content[0];
+  if (!item) throw new Error('expected MCP text content');
+  return item.text;
+}
+
+function withDirectory(
+  fn: (url: string, init?: RequestInit) => Promise<Response>,
+): (url: string, init?: RequestInit) => Promise<Response> {
+  return async (url: string, init?: RequestInit) => {
+    if (String(url).endsWith('/api/workspace/directory')) {
+      return new Response(JSON.stringify({ items: [], activeWorkspaceId: null }), { status: 200 });
+    }
+    return fn(url, init);
+  };
+}
+
+describe('ChatGPT restricted MCP profile', () => {
+  afterEach(() => {
+    _resetMcpWorkspaceContextCacheForTests();
+    vi.unstubAllGlobals();
+    globalThis.fetch = originalFetch;
+    if (originalExportMaxBytes === undefined) delete process.env.OD_MCP_EXPORT_MAX_BYTES;
+    else process.env.OD_MCP_EXPORT_MAX_BYTES = originalExportMaxBytes;
+  });
+
+  it('publishes only deterministic local design tools and requires explicit ids/preconditions', () => {
+    const definitions = localMcpToolDefinitions('chatgpt');
+    const names = definitions.map((tool) => tool.name);
+    expect(names).toContain('write_file');
+    expect(names).toContain('get_preview');
+    expect(names).toContain('export_artifact');
+    expect(names).not.toContain('start_run');
+    expect(names).not.toContain('get_run');
+    expect(names).not.toContain('cancel_run');
+    expect(names).not.toContain('list_agents');
+    expect(names).not.toContain('start_vela_login');
+    expect(names).not.toContain('get_vela_login_status');
+    expect(names).not.toContain('delete_project');
+    expect(names).not.toContain('collect_brief');
+    expect(names).not.toContain('confirm_brief');
+
+    const write = definitions.find((tool) => tool.name === 'write_file');
+    expect(write?.inputSchema.required).toEqual(
+      expect.arrayContaining(['project', 'path', 'content', 'precondition']),
+    );
+    const createProject = definitions.find((tool) => tool.name === 'create_project');
+    expect(createProject?.inputSchema.required).toEqual(expect.arrayContaining(['name', 'id']));
+  });
+
+  it('rejects a hidden tool in dispatch without touching the daemon', async () => {
+    const fetchMock = vi.fn();
+    vi.stubGlobal('fetch', fetchMock);
+    const result = await handleMcpToolCall(
+      'http://127.0.0.1:9999',
+      'start_run',
+      { project: PROJECT_ID },
+      { profile: 'chatgpt', allowedProjectIds: new Set([PROJECT_ID]) },
+    );
+    expect(result).toMatchObject({ isError: true });
+    expect(firstText(result)).toContain('not available');
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('rejects an unapproved project id before daemon access', async () => {
+    const fetchMock = vi.fn();
+    vi.stubGlobal('fetch', fetchMock);
+    const result = await handleMcpToolCall(
+      'http://127.0.0.1:9999',
+      'get_project',
+      { project: '22222222-2222-4222-8222-222222222222' },
+      { profile: 'chatgpt', allowedProjectIds: new Set([PROJECT_ID]) },
+    );
+    expect(result).toMatchObject({ isError: true });
+    expect(firstText(result)).toContain('authorized');
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it('filters list_projects to the connection allowlist', async () => {
+    const fetchMock = vi.fn(async (url: string) => {
+      if (url.endsWith('/api/projects')) {
+        return new Response(JSON.stringify({
+          projects: [
+            { id: PROJECT_ID, name: 'Allowed' },
+            { id: '33333333-3333-4333-8333-333333333333', name: 'Hidden' },
+          ],
+        }), { status: 200 });
+      }
+      return new Response('{}', { status: 404 });
+    });
+    vi.stubGlobal('fetch', withDirectory(fetchMock));
+    const result = await handleMcpToolCall(
+      'http://127.0.0.1:9998',
+      'list_projects',
+      {},
+      { profile: 'chatgpt', allowedProjectIds: new Set([PROJECT_ID]) },
+    );
+    expect(JSON.parse(firstText(result))).toEqual({
+      projects: [{ id: PROJECT_ID, name: 'Allowed' }],
+    });
+  });
+
+  it('returns one full-file raw digest across paginated windows', async () => {
+    const source = 'alpha\nbeta\ngamma';
+    const expected = createHash('sha256').update(Buffer.from(source)).digest('hex');
+    const fetchMock = vi.fn(async (url: string) => {
+      if (url.includes('/raw/notes.txt')) {
+        return new Response(source, {
+          status: 200,
+          headers: { 'content-type': 'text/plain; charset=utf-8' },
+        });
+      }
+      return new Response('{}', { status: 404 });
+    });
+    vi.stubGlobal('fetch', withDirectory(fetchMock));
+    const base = 'http://127.0.0.1:9997';
+    const options = { profile: 'chatgpt' as const, allowedProjectIds: new Set([PROJECT_ID]) };
+    const first = await handleMcpToolCall(base, 'get_file', {
+      project: PROJECT_ID,
+      path: 'notes.txt',
+      offset: 0,
+      limit: 1,
+    }, options);
+    const second = await handleMcpToolCall(base, 'get_file', {
+      project: PROJECT_ID,
+      path: 'notes.txt',
+      offset: 1,
+      limit: 2,
+    }, options);
+    expect(first.structuredContent).toMatchObject({ contentDigest: expected, truncated: true });
+    expect(second.structuredContent).toMatchObject({ contentDigest: expected });
+  });
+
+  it('returns a binary digest without exposing binary content in the restricted profile', async () => {
+    const bytes = Buffer.from([0, 1, 2, 250, 255]);
+    const expected = createHash('sha256').update(bytes).digest('hex');
+    const fetchMock = vi.fn(async (url: string) => {
+      if (url.includes('/raw/image.bin')) {
+        return new Response(bytes, {
+          status: 200,
+          headers: { 'content-type': 'application/octet-stream' },
+        });
+      }
+      return new Response('{}', { status: 404 });
+    });
+    vi.stubGlobal('fetch', withDirectory(fetchMock));
+    const result = await handleMcpToolCall(
+      'http://127.0.0.1:9965',
+      'get_file',
+      { project: PROJECT_ID, path: 'image.bin' },
+      { profile: 'chatgpt', allowedProjectIds: new Set([PROJECT_ID]) },
+    );
+    expect(result.structuredContent).toMatchObject({
+      contentDigest: expected,
+      binary: true,
+      byteLength: bytes.length,
+    });
+    expect(firstText(result)).toContain(expected);
+  });
+
+  it('supports an empty write and forwards the digest precondition', async () => {
+    const digest = 'a'.repeat(64);
+    const fetchMock = vi.fn(async (url: string, init?: RequestInit) => {
+      if (url.endsWith(`/api/projects/${PROJECT_ID}/files`)) {
+        return new Response(JSON.stringify({ file: { name: 'empty.txt' }, contentDigest: 'b'.repeat(64) }), { status: 200 });
+      }
+      return new Response('{}', { status: 404 });
+    });
+    vi.stubGlobal('fetch', withDirectory(fetchMock));
+    const result = await handleMcpToolCall(
+      'http://127.0.0.1:9996',
+      'write_file',
+      {
+        project: PROJECT_ID,
+        path: 'empty.txt',
+        content: '',
+        precondition: { contentDigest: digest },
+      },
+      { profile: 'chatgpt', allowedProjectIds: new Set([PROJECT_ID]) },
+    );
+    expect(result).not.toMatchObject({ isError: true });
+    const writeCall = fetchMock.mock.calls.find((call) => String(call[0]).endsWith('/files'));
+    expect(writeCall).toBeTruthy();
+    expect(JSON.parse(String(writeCall?.[1]?.body))).toMatchObject({
+      name: 'empty.txt',
+      content: '',
+      expectedContentDigest: digest,
+    });
+  });
+
+  it('rejects a chunked export once the bounded MCP payload limit is exceeded', async () => {
+    process.env.OD_MCP_EXPORT_MAX_BYTES = '4';
+    const fetchMock = vi.fn(async (url: string, init?: RequestInit) => {
+      if (url.endsWith(`/api/projects/${PROJECT_ID}/export`) && init?.method === 'POST') {
+        return new Response(Uint8Array.from([1, 2, 3, 4, 5]), {
+          status: 200,
+          headers: { 'content-type': 'application/pdf' },
+        });
+      }
+      return new Response('{}', { status: 404 });
+    });
+    vi.stubGlobal('fetch', withDirectory(fetchMock));
+    const result = await handleMcpToolCall(
+      'http://127.0.0.1:9994',
+      'export_artifact',
+      { project: PROJECT_ID, fileName: 'index.html', format: 'pdf' },
+      { profile: 'chatgpt', allowedProjectIds: new Set([PROJECT_ID]) },
+    );
+    expect(result).toMatchObject({ isError: true });
+    expect(firstText(result)).toContain('EXPORT_TOO_LARGE');
+  });
+
+  it('does not retry restricted project creation without authorization headers', async () => {
+    const id = 'new-project';
+    const fetchMock = vi.fn(async (url: string, init?: RequestInit) => {
+      if (url.endsWith(`/api/projects/${id}`)) {
+        return new Response('{}', { status: 404 });
+      }
+      if (url.endsWith('/api/projects') && init?.method === 'POST') {
+        return new Response(JSON.stringify({
+          error: { code: 'WORKSPACE_CONTEXT_REQUIRED', message: 'workspace required' },
+        }), { status: 403 });
+      }
+      return new Response('{}', { status: 404 });
+    });
+    vi.stubGlobal('fetch', withDirectory(fetchMock));
+    const result = await handleMcpToolCall(
+      'http://127.0.0.1:9995',
+      'create_project',
+      { id, name: 'New project' },
+      { profile: 'chatgpt', allowedProjectIds: new Set() },
+    );
+    expect(result).toMatchObject({ isError: true });
+    const posts = fetchMock.mock.calls.filter(
+      (call) => String(call[0]).endsWith('/api/projects') && call[1]?.method === 'POST',
+    );
+    expect(posts).toHaveLength(1);
+  });
+});
diff --git a/apps/daemon/tests/projects-atomic-write.test.ts b/apps/daemon/tests/projects-atomic-write.test.ts
