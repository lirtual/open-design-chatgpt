+async function hashResponseBody(resp: Response): Promise<{ contentDigest: string; byteLength: number }> {
+  const hash = createHash('sha256');
+  let byteLength = 0;
+  if (!resp.body) {
+    const bytes = Buffer.from(await resp.arrayBuffer());
+    hash.update(bytes);
+    return { contentDigest: hash.digest('hex'), byteLength: bytes.length };
+  }
+  const reader = resp.body.getReader();
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      if (!value || value.byteLength === 0) continue;
+      hash.update(value);
+      byteLength += value.byteLength;
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  return { contentDigest: hash.digest('hex'), byteLength };
+}
+
+async function readResponseBytesWithLimit(resp: Response, limit: number): Promise<Buffer> {
+  const declared = Number(resp.headers.get('content-length'));
+  if (Number.isFinite(declared) && declared > limit) {
+    throw new Error(`EXPORT_TOO_LARGE: ${declared} bytes exceeds MCP export limit ${limit}`);
+  }
+  if (!resp.body) {
+    const bytes = Buffer.from(await resp.arrayBuffer());
+    if (bytes.length > limit) {
+      throw new Error(`EXPORT_TOO_LARGE: ${bytes.length} bytes exceeds MCP export limit ${limit}`);
+    }
+    return bytes;
+  }
+  const reader = resp.body.getReader();
+  const chunks: Buffer[] = [];
+  let total = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      if (!value || value.byteLength === 0) continue;
+      total += value.byteLength;
+      if (total > limit) {
+        await reader.cancel();
+        throw new Error(`EXPORT_TOO_LARGE: response exceeded MCP export limit ${limit}`);
+      }
+      chunks.push(Buffer.from(value));
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  return Buffer.concat(chunks, total);
+}
