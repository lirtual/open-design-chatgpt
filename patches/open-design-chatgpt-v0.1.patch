+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+
+import {
+  projectFileWriteTestHooks,
+  writeProjectFile,
+} from '../src/projects.js';
+
+let root: string | null = null;
+
+describe('project file atomic commit', () => {
+  afterEach(async () => {
+    projectFileWriteTestHooks.beforeCommit = null;
+    projectFileWriteTestHooks.afterCommit = null;
+    if (root) await rm(root, { recursive: true, force: true });
+    root = null;
+  });
+
+  it('preserves a competing file when a create-only target appears before commit', async () => {
+    root = await mkdtemp(path.join(os.tmpdir(), 'od-atomic-write-'));
+    const projectId = 'project-1';
+    const target = path.join(root, projectId, 'new.txt');
+    projectFileWriteTestHooks.beforeCommit = async () => {
+      await writeFile(target, 'external-winner', 'utf8');
+    };
+
+    await expect(writeProjectFile(
+      root,
+      projectId,
+      'new.txt',
+      Buffer.from('ours'),
+      { overwrite: false },
+    )).rejects.toMatchObject({ code: 'EEXIST' });
+
+    expect(await readFile(target, 'utf8')).toBe('external-winner');
+  });
+
+  it('uses a completed temp file as the atomic replacement commit', async () => {
+    root = await mkdtemp(path.join(os.tmpdir(), 'od-atomic-write-'));
+    const projectId = 'project-2';
+    await writeProjectFile(root, projectId, 'file.txt', Buffer.from('v1'));
+    await writeProjectFile(
+      root,
+      projectId,
+      'file.txt',
+      Buffer.from('v2'),
+      { atomicReplace: true },
+    );
+    expect(await readFile(path.join(root, projectId, 'file.txt'), 'utf8')).toBe('v2');
+  });
+});
diff --git a/apps/daemon/tests/project-file-preconditions.test.ts b/apps/daemon/tests/project-file-preconditions.test.ts
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/apps/daemon/tests/project-file-preconditions.test.ts
@@ -0,0 +1,170 @@
+import { createHash, randomUUID } from 'node:crypto';
+import type http from 'node:http';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+
+import { startServer } from '../src/server.js';
+
+function digest(bytes: Uint8Array | string): string {
+  return createHash('sha256')
+    .update(typeof bytes === 'string' ? Buffer.from(bytes) : bytes)
+    .digest('hex');
+}
+
+describe('project file optimistic preconditions', () => {
+  let server: http.Server;
+  let baseUrl: string;
+  const projects: string[] = [];
+
+  beforeAll(async () => {
+    const started = (await startServer({ port: 0, returnServer: true })) as {
+      url: string;
+      server: http.Server;
+    };
+    baseUrl = started.url;
+    server = started.server;
+  });
+
+  afterAll(async () => {
+    for (const id of projects) {
+      await fetch(`${baseUrl}/api/projects/${id}`, { method: 'DELETE' }).catch(() => {});
+    }
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  });
+
+  async function createProject(): Promise<string> {
+    const id = `conditional-file-${randomUUID()}`;
+    const response = await fetch(`${baseUrl}/api/projects`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ id, name: 'Conditional file test' }),
+    });
+    expect(response.ok).toBe(true);
+    projects.push(id);
+    return id;
+  }
+
+  async function write(
+    projectId: string,
+    body: Record<string, unknown>,
+  ): Promise<Response> {
+    return fetch(`${baseUrl}/api/projects/${projectId}/files`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify(body),
+    });
+  }
+
+  async function read(projectId: string, fileName: string): Promise<Buffer> {
+    const response = await fetch(`${baseUrl}/api/projects/${projectId}/raw/${fileName}`);
+    expect(response.ok).toBe(true);
+    return Buffer.from(await response.arrayBuffer());
+  }
+
+  it('rejects a stale overwrite and leaves the winning bytes intact', async () => {
+    const projectId = await createProject();
+    expect((await write(projectId, { name: 'index.html', content: 'v1' })).ok).toBe(true);
+    const v1 = digest('v1');
+
+    const winner = await write(projectId, {
+      name: 'index.html',
+      content: 'v2',
+      expectedContentDigest: v1,
+    });
+    expect(winner.ok).toBe(true);
+    const winnerBody = await winner.json() as { contentDigest: string };
+    expect(winnerBody.contentDigest).toBe(digest('v2'));
+
+    const stale = await write(projectId, {
+      name: 'index.html',
+      content: 'stale-v3',
+      expectedContentDigest: v1,
+    });
+    expect(stale.status).toBe(409);
+    const staleBody = await stale.json() as {
+      error?: { code?: string; details?: { currentContentDigest?: string } };
+    };
+    expect(staleBody.error?.code).toBe('FILE_VERSION_CONFLICT');
+    expect(staleBody.error?.details?.currentContentDigest).toBe(digest('v2'));
+    expect((await read(projectId, 'index.html')).toString('utf8')).toBe('v2');
+  });
+
+  it('serializes two managed writers so only one identical precondition can win', async () => {
+    const projectId = await createProject();
+    expect((await write(projectId, { name: 'race.txt', content: 'base' })).ok).toBe(true);
+    const expectedContentDigest = digest('base');
+
+    const [a, b] = await Promise.all([
+      write(projectId, { name: 'race.txt', content: 'A', expectedContentDigest }),
+      write(projectId, { name: 'race.txt', content: 'B', expectedContentDigest }),
+    ]);
+    expect([a.status, b.status].sort()).toEqual([200, 409]);
+    const final = (await read(projectId, 'race.txt')).toString('utf8');
+    expect(['A', 'B']).toContain(final);
+  });
+
+  it('uses missing:true as create-only and protects a target that already exists', async () => {
+    const projectId = await createProject();
+    const created = await write(projectId, {
+      name: 'created.txt',
+      content: 'first',
+      expectedMissing: true,
+    });
+    expect(created.ok).toBe(true);
+
+    const duplicate = await write(projectId, {
+      name: 'created.txt',
+      content: 'second',
+      expectedMissing: true,
+    });
+    expect(duplicate.status).toBe(409);
+    expect((await read(projectId, 'created.txt')).toString('utf8')).toBe('first');
+  });
+
+  it('accepts empty UTF-8 and hashes persisted binary bytes, not base64 text', async () => {
+    const projectId = await createProject();
+    const empty = await write(projectId, {
+      name: 'empty.txt',
+      content: '',
+      expectedMissing: true,
+    });
+    expect(empty.ok).toBe(true);
+    const emptyBody = await empty.json() as { contentDigest: string };
+    expect(emptyBody.contentDigest).toBe(digest(''));
+    expect((await read(projectId, 'empty.txt')).length).toBe(0);
+
+    const binary = Buffer.from([0, 1, 2, 3, 254, 255]);
+    const binaryWrite = await write(projectId, {
+      name: 'image.bin',
+      content: binary.toString('base64'),
+      encoding: 'base64',
+      expectedMissing: true,
+    });
+    expect(binaryWrite.ok).toBe(true);
+    const binaryBody = await binaryWrite.json() as { contentDigest: string };
+    expect(binaryBody.contentDigest).toBe(digest(binary));
+    expect(await read(projectId, 'image.bin')).toEqual(binary);
+  });
+
+  it('requires the current digest for delete and preserves the file on conflict', async () => {
+    const projectId = await createProject();
+    expect((await write(projectId, { name: 'delete-me.txt', content: 'current' })).ok).toBe(true);
+    const current = digest('current');
+
+    const stale = await fetch(`${baseUrl}/api/projects/${projectId}/raw/delete-me.txt`, {
+      method: 'DELETE',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ expectedContentDigest: '0'.repeat(64) }),
+    });
+    expect(stale.status).toBe(409);
+    expect((await read(projectId, 'delete-me.txt')).toString('utf8')).toBe('current');
+
+    const removed = await fetch(`${baseUrl}/api/projects/${projectId}/raw/delete-me.txt`, {
+      method: 'DELETE',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ expectedContentDigest: current }),
+    });
+    expect(removed.ok).toBe(true);
+    const missing = await fetch(`${baseUrl}/api/projects/${projectId}/raw/delete-me.txt`);
+    expect(missing.status).toBe(404);
+  });
+});
